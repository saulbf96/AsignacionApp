<Window x:Class="AsignacionApp.VentanaReporte"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Resultado de la conversión" MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#F3F5F8" FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#C5CCD6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <!-- Tarjeta con un número grande y su etiqueta -->
        <Style x:Key="Tarjeta" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DDE2E8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style x:Key="Numero" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1F4E78"/>
        </Style>
        <Style x:Key="Etiqueta" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#5A6573"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Título: verde si todo se unió, naranja si algún archivo se omitió -->
        <TextBlock Grid.Row="0" x:Name="TxtTitulo" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>

        <UniformGrid Grid.Row="1" Rows="1" Margin="0,0,-10,12">
            <Border Style="{StaticResource Tarjeta}">
                <StackPanel>
                    <TextBlock x:Name="TxtLeidos" Style="{StaticResource Numero}"/>
                    <TextBlock Text="Registros leídos" Style="{StaticResource Etiqueta}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Tarjeta}">
                <StackPanel>
                    <TextBlock x:Name="TxtEscritos" Style="{StaticResource Numero}"/>
                    <TextBlock Text="Registros escritos" Style="{StaticResource Etiqueta}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Tarjeta}">
                <StackPanel>
                    <TextBlock x:Name="TxtCorregidos" Style="{StaticResource Numero}"/>
                    <TextBlock Text="Valores corregidos" Style="{StaticResource Etiqueta}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Tarjeta}">
                <StackPanel>
                    <TextBlock x:Name="TxtAdvertencias" Style="{StaticResource Numero}"/>
                    <TextBlock Text="Advertencias (datos de origen)" Style="{StaticResource Etiqueta}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <TextBlock Grid.Row="2" x:Name="TxtGenerados" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="#1F4E78"/>

        <!-- Bitácora completa: sin ajuste de línea para que las columnas queden alineadas -->
        <TextBox Grid.Row="3" x:Name="TxtBitacora" IsReadOnly="True"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12"
                 Background="White" BorderBrush="#DDE2E8" Padding="6"/>

        <DockPanel Grid.Row="4" Margin="0,12,0,0" LastChildFill="False">
            <Button x:Name="BtnAbrirArchivo" Content="Abrir Excel" Click="AbrirArchivo_Click"/>
            <Button Content="Abrir carpeta" Click="AbrirCarpeta_Click"/>
            <Button Content="Copiar bitácora" Click="Copiar_Click"/>
            <Button DockPanel.Dock="Right" Content="Cerrar" IsCancel="True" IsDefault="True" Margin="0"
                    Background="#1F4E78" Foreground="White" BorderBrush="#1F4E78" FontWeight="SemiBold" Padding="22,6"/>
        </DockPanel>
    </Grid>
</Window>
