<Window x:Class="AsignacionApp.VentanaContrasena"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Contraseña del ZIP" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#F3F5F8" FontFamily="Segoe UI" FontSize="13">
    <StackPanel Margin="16" Width="340">
        <TextBlock x:Name="TxtMensaje" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <PasswordBox x:Name="CajaContrasena" Padding="4" Margin="0,0,0,14"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Aceptar" IsDefault="True" Click="Aceptar_Click" Padding="16,5" Margin="0,0,8,0"
                    Background="#1F4E78" Foreground="White" BorderBrush="#1F4E78"/>
            <Button Content="Cancelar" IsCancel="True" Padding="16,5"/>
        </StackPanel>
    </StackPanel>
</Window>
